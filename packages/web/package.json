{
  "name": "@fractality/web",
  "version": "1.0.0",
  "description": "Web module of Fractality.",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./addressing": {
      "types": "./dist/payload/paths.d.ts",
      "default": "./dist/payload/paths.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "default": "./dist/shell/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sitepark/fractality.git",
    "directory": "packages/web"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sitepark/fractality/issues"
  },
  "homepage": "https://github.com/sitepark/fractality/tree/main/packages/web",
  "dependencies": {
    "@fractality/core": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "get-port": "^7.2.0",
    "path-to-regexp": "^8.4.2",
    "vite": "^8.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
