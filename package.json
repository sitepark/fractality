{
  "name": "fractality",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@biomejs/biome": "^2.6.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "jest-extended": "^7.0.0",
    "jsdom": "^30.1.1",
    "lerna": "^10.1.3",
    "lint-staged": "^17.6.1",
    "mock-argv": "^5.0.0",
    "mock-fs": "^5.5.0",
    "semver": "^7.8.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "clean": "lerna clean",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit -p packages/web/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.test.json && tsc --noEmit -p packages/mandelbrot/tsconfig.json",
    "validate": "biome check && pnpm run typecheck",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "prepare": "husky"
  }
}
